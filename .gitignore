# ============================================================
# Git Ignore Configuration for RE Stream / Live Streaming Web
# ============================================================

# Dependencies
node_modules/

# Environment Configurations (Contain sensitive secrets)
.env
.env.local
.env.*.local

# Runtime Logs
logs/*
!logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*

# Generated Playlists
playlists/*
!playlists/.gitkeep

# Uploaded Media (Videos, Audios, Thumbnails)
uploads/videos/*
!uploads/videos/.gitkeep
uploads/audios/*
!uploads/audios/.gitkeep
uploads/thumbnails/*
!uploads/thumbnails/.gitkeep

# Runtime Data & Session Tokens
data/*
!data/.gitkeep
scratch/

# OS and IDE Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
