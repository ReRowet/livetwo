# ============================================================
# RE Stream — Environment Configuration
# ============================================================

# Plain text Auth Credentials (No hashing)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# JWT Security Secrets
JWT_SECRET=re_stream_jwt_secret_token_2026_super_secure
JWT_REFRESH_SECRET=re_stream_jwt_refresh_secret_2026_super_secure

# Server Port
PORT=3002

# Custom FFmpeg/FFprobe Binary Paths (Optional, default uses system PATH or ./bin)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
